# merida-unificada — variables de entorno de ejemplo.
# Copia este archivo a .env.local (está ignorado por Git) y completa sólo lo que necesites.
# El prototipo funciona SIN ninguna de estas variables: usa datos y respuestas de demostración.
#
# REGLA: los secretos (claves, tokens) van SÓLO en variables SIN prefijo VITE_, que lee únicamente
# el servidor (server/). Todo lo que empieza con VITE_ se incrusta en el JavaScript del navegador y
# es público: nunca pongas ahí una clave secreta.

# ───────────────────────── Navegador (públicas) ─────────────────────────

# Modo de la capa de servicios: "demo" (datos ficticios en el navegador) o "real".
# En "real" no hay adaptadores disponibles todavía: cada pantalla muestra un error explícito.
VITE_INTEGRATION_MODE=demo

# Mapa: token PÚBLICO de Mapbox (empieza con pk.). Opcional. Sin token se usa MapLibre con
# OpenFreeMap. Se rechaza un token secreto (sk.). Restringe el token por URL en tu cuenta de Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=
# Estilo de Mapbox opcional (mapbox://styles/...).
VITE_MAPBOX_STYLE_URL=

# ───────────────────────── Servidor ligero (privadas) ─────────────────────────

# Puerto del servidor (el front lo consulta por el proxy /api de Vite).
PORT=8787
# Orígenes permitidos para peticiones de escritura, separados por comas.
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:4173

# Asistente con voz e IA real: OpenAI Realtime. Sin clave, el asistente usa respuestas programadas
# (modo demostración) y la interfaz lo dice.
OPENAI_API_KEY=
# Modelo y voz por defecto: VERIFICA su disponibilidad y precio en la documentación de OpenAI.
ASISTENTE_REALTIME_MODEL=gpt-realtime-2.1
ASISTENTE_VOZ=marin
# Duración máxima de una conversación (60–3600 s) e inicios por IP y hora (1–1000).
ASISTENTE_MAX_SEGUNDOS=900
ASISTENTE_MAX_INICIOS_HORA=20

# Guardas Clef (Cloudflare Workers AI): señal extra para saber si la persona pidió una acción.
# Nunca autorizan nada: la confirmación en pantalla siempre es obligatoria.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# clef (más preciso) o clef-flash (más rápido).
CLEF_MODEL=clef
CLEF_TIMEOUT_MS=2500
# off | shadow (sólo informa; recomendado al empezar) | enforce (pide confirmar si la probabilidad es baja).
ASISTENTE_GUARDAS=shadow

# Salud mental con IA real: desactivado por defecto. Aunque se active, exige consentimiento
# explícito de la persona y requiere una revisión específica antes de cualquier uso real
# (ver docs/PRIVACIDAD_Y_SEGURIDAD.md).
BIENESTAR_IA_REAL=false
