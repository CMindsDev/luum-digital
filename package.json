{
  "name": "merida-unificada",
  "private": true,
  "version": "0.1.0",
  "description": "Prototipo de demostración: experiencia unificada de servicios digitales del Ayuntamiento de Mérida. No realiza gestiones oficiales.",
  "type": "module",
  "scripts": {
